{
  "name": "reels-pro-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo autoral de Reels com Remotion, narração PT-BR, captions e masterização mensurável.",
  "scripts": {
    "audio": "python3 scripts/build_audio.py",
    "studio": "remotion studio src/Root.jsx",
    "fashion:studio": "node scripts/start_fashion_studio.mjs",
    "render": "node render.mjs",
    "still": "node render.mjs --still --frame 55 --output out/capa.jpg",
    "fashion:prepare": "python3 scripts/prepare_fashion.py",
    "fashion:render": "node fashion-render.mjs",
    "fashion:still": "node fashion-render.mjs --still --frame 160 --output out/edite-esse-capa.jpg",
    "fashion:storyboard": "node fashion-render.mjs --storyboard",
    "qa:fashion:project": "python3 scripts/validate_fashion.py",
    "qa:fashion:captions": "python3 ../skills/captions/scripts/caption_qa.py fashion-captions.srt --video out/edite-esse-final.mp4 --max-cps 22 --max-lines 2 --strict --output reports/fashion-caption-qa.json",
    "qa:fashion:video": "python3 ../skills/video-quality/scripts/video_qa.py out/edite-esse-final.mp4 --expected-width 1080 --expected-height 1920 --min-fps 30 --target-loudness -14 --loudness-tolerance 0.5 --max-true-peak -1 --strict --output reports/fashion-video-qa.json --contact-sheet out/fashion-contact-qa.jpg",
    "qa:fashion": "npm run qa:fashion:project && npm run qa:fashion:captions && npm run qa:fashion:video",
    "qa:project": "python3 scripts/validate_project.py",
    "qa:captions": "python3 ../skills/captions/scripts/caption_qa.py captions.srt --video out/reels-pro-demo.mp4 --strict --output reports/caption-qa.json",
    "qa:video": "python3 ../skills/video-quality/scripts/video_qa.py out/reels-pro-demo.mp4 --expected-width 1080 --expected-height 1920 --min-fps 60 --target-loudness -14 --loudness-tolerance 0.5 --max-true-peak -1 --strict --output reports/video-qa.json --contact-sheet out/contact-qa.jpg",
    "qa": "npm run qa:project && npm run qa:captions && npm run qa:video"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.522",
    "@remotion/cli": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "http-proxy": "1.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.522"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}
